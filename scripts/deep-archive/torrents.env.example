# EVE Ref Deep Archive settings. Copy to torrents.env (not committed) and fill in.
# The scripts read this file for anything not already set in the environment (lib/workflow.py).

# Work files for the current workflow: completion files, find output, manifest, .torrent, logs.
# Must be empty when a workflow starts (00-preflight). Delete it by hand once the workflow is complete.
SCRATCH_DIR=

# Torrent content, one folder per torrent ID: $SEED_DIR/<ID>/. Kept for seeding (qBittorrent save path).
# Needs room for the largest possible torrent (MAX_BYTES in lib/workflow.py).
SEED_DIR=

# The data site's bucket on B2. Its root is the site root (index.json at the top).
DATA_BUCKET=

# The B2 key for the "everef" rclone remote. Only these are secrets; the rest of the remote is fixed in
# lib/workflow.py.
RCLONE_CONFIG_EVEREF_ACCOUNT=
RCLONE_CONFIG_EVEREF_KEY=

# Optional: a local copy of the data site, laid out like the bucket (index.json at the top). 03-load copies the files
# it has with the selected size, modification time and SHA-1 from here instead of downloading them. Read only.
LOCAL_COPY_DIR=

# qBittorrent's Web API (00-preflight, 05-seed, 06-check-seed). QBITTORRENT_USERNAME/PASSWORD can be left
# blank if the Web API has no auth (e.g. "Bypass authentication for clients on localhost").
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Optional: SEED_DIR as qBittorrent sees it, if that differs (e.g. qBittorrent in Docker with SEED_DIR mounted at
# /downloads). 05-seed adds torrents with this save path; SEED_DIR is used if it's blank.
QBITTORRENT_SAVE_PATH=
